ANTHROPIC_API_KEY=sk-ant-...

# Optional: switch models without code changes
# ANSWER_MODEL=claude-sonnet-4-6
# VERIFIER_MODEL=claude-haiku-4-5

# Optional: lokales LLM für die zwei Modus-2-Calls (expand_query, rerank).
# Default anthropic. Bei "local" laufen nur diese beiden Calls gegen einen
# OpenAI-kompatiblen Endpunkt (z. B. Ollama). answer/verify/parse_context
# bleiben immer auf Anthropic. Kein Fallback: Server aus → klarer Fehler.
# LLM_PROVIDER=local
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL_EXPAND=qwen3:4b
# LOCAL_API_KEY=ollama

# Modus 3 lokal (agent_local). Tabellenwerte laufen IMMER über den
# deterministischen Fast-Path (wörtlicher Wert + Quelle). Für Nicht-
# Tabellenfragen bestimmt AGENT_LOCAL_MODE das Verhalten:
#   sources  (Default) — Quellen + wörtlicher Snippet, KEIN LLM-Fließtext
#                        (Anti-Halluzination: richtige Seiten zeigen, Nutzer liest).
#   tools              — Seeded Tool-Loop (Modell formuliert; Halluzinationsrisiko).
#   pipeline           — eine Modell-Synthese aus der Top-Seite.
# AGENT_LOCAL_MODE=sources

# Welcher Agent bedient "Assistent" (Modus 3)? Umschaltbar unabhängig von
# LLM_PROVIDER — so kann Modus 2 lokal laufen und Modus 3 trotzdem über Claude
# (deutlich bessere Qualität, braucht Internet + ANTHROPIC_API_KEY). Auch per
# Request-Feld agent_backend überschreibbar (Laufzeit-Umschalter aus der UI).
#   auto (Default) — folgt LLM_PROVIDER (local → agent_local, sonst Anthropic)
#   anthropic      — immer der bisherige Anthropic-Agent (agent.py)
#   local          — immer der lokale agent_local
# AGENT_BACKEND=auto
# AGENT_LOCAL_MAX_ROUNDS=6           # Tool-Loop: max. Runden gesamt
# AGENT_LOCAL_MAX_TOOL_ROUNDS=4      # Tool-Loop: danach Antwort erzwingen (Tools aus)
# AGENT_LOCAL_READ_CHARS=3000        # Tool-Loop: read_page-Obergrenze (4B-freundlich)
# Schwellen auf der RRF×1000-Score-Skala — bei Bedarf kalibrieren:
# AGENT_LOCAL_MIN_SCORE=8.0          # darunter: gar kein Modell-Call ("nicht gefunden")
# AGENT_LOCAL_ESCALATE_SCORE=25.0    # (nur pipeline) darunter: gezielte Eskalation
# AGENT_LOCAL_MAX_CONTEXT=3500       # (nur pipeline) max. Seitentext-Zeichen

# Retrieval: Dokumenttyp-Prior — hebt Referenz-/Konfig-/Tabellenseiten
# (Zusammenstellung, Übersicht, Wahl, Traglasttabelle …) generisch im Ranking.
# 1.0 = aus. Gilt für beide Provider (geteilte Suche).
# SEARCH_DOCTYPE_BOOST=1.25
