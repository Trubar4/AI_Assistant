ANTHROPIC_API_KEY=sk-ant-...

# Optional: switch models without code changes
# ANSWER_MODEL=claude-sonnet-4-6
# VERIFIER_MODEL=claude-haiku-4-5

# Optional: lokales LLM für die zwei Modus-2-Calls (expand_query, rerank).
# Default anthropic. Bei "local" laufen nur diese beiden Calls gegen einen
# OpenAI-kompatiblen Endpunkt (z. B. Ollama). answer/verify/parse_context
# bleiben immer auf Anthropic. Kein Fallback: Server aus → klarer Fehler.
# LLM_PROVIDER=local
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL_EXPAND=qwen3:4b
# LOCAL_API_KEY=ollama
